  ],
  "phases": [
    {"id": "scope", "label": "현재 요청", "fromCol": 0, "toCol": 1},
    {"id": "activity", "label": "호출과 결과", "fromCol": 2, "toCol": 3},
    {"id": "evidence", "label": "근거와 완료 판단", "fromCol": 4, "toCol": 5}
